{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumia Launcher",
  "version": "1.0.0-beta.1",
  "identifier": "com.xiaotiangua.lumia",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Lumia Launcher",
        "width": 900,
        "height": 600,
        "minWidth": 750,
        "minHeight": 500,
        "resizable": true,
        "center": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "windowEffects": {
          "effects": ["blur"]
        }
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1420 stream:; img-src 'self' data: https: http://127.0.0.1:1420 asset: http://asset.localhost; media-src 'self' stream: data: blob:; style-src 'unsafe-inline' 'self' https: http://127.0.0.1:1420; script-src 'unsafe-inline' 'unsafe-eval' 'self' https: http://127.0.0.1:1420;"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "targets": ["app", "dmg"],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}